---
import { repo, releases } from '../site';
---

<section class="closing" id="download">
  <div class="wrap">
    <h2>Write in a folder you own.</h2>
    <p class="lede">
      Free, and there is no account to make. Choose a folder the first time you open it and
      Milky never asks again.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={releases}>Download for Mac</a>
      <a class="btn btn-quiet" href={repo}>Build from source</a>
    </div>
    <p class="requirement">Requires macOS 14 or later.</p>
  </div>
</section>

<style>
  /* The rule needs the page's own section rhythm above it, or the previous
     section's last line sits right on top of it. */
  .closing {
    margin-top: clamp(52px, 8vw, 92px);
    border-top: 1px solid var(--rule);
    padding: clamp(56px, 8vw, 96px) 0;
  }
  .closing h2 { font-size: clamp(1.7rem, 3.6vw, 2.35rem); }
</style>
