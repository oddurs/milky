---
import AppWindow from './AppWindow.astro';
---

<section class="stage">
  <div class="stage-inner">
    <AppWindow />
  </div>

  <p class="caption">
    <button class="btn btn-quiet btn-sm" id="reveal" aria-pressed="false">Show the markdown</button>
    <span>Or click any line. The syntax never left the file — it just steps back until your cursor arrives.</span>
  </p>
</section>

<script is:inline>
  // The one interaction on the page: put the cursor on a line and its markdown
  // punctuation comes forward, exactly as the editor does.
  (() => {
    const doc = document.getElementById('doc');
    const reveal = document.getElementById('reveal');
    const lines = [...doc.querySelectorAll('.ln')];

    const clearCursor = () => lines.forEach((line) => line.classList.remove('on'));

    lines.forEach((line) => {
      line.addEventListener('click', (event) => {
        if (event.target.closest('a')) return;
        const wasOn = line.classList.contains('on');
        clearCursor();
        if (!wasOn) line.classList.add('on');
      });
    });

    // The keyboard path to the same idea, and the clearer affordance of the two.
    reveal.addEventListener('click', () => {
      const showing = doc.classList.toggle('reveal');
      reveal.setAttribute('aria-pressed', String(showing));
      reveal.textContent = showing ? 'Hide the markdown' : 'Show the markdown';
      if (showing) clearCursor();
    });
  })();
</script>

<style>
  .stage {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--surface-sunken) 72%, var(--surface)),
      var(--surface-sunken) 46%
    );
    padding: clamp(30px, 5.5vw, 66px) 0 clamp(26px, 4vw, 46px);
    border-block: 1px solid var(--rule-soft);
  }

  .stage-inner {
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }

  .caption {
    margin: 20px auto 0;
    max-width: 1120px;
    padding-inline: clamp(20px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    font-size: 13.5px;
    color: var(--ink-soft);
  }
</style>
