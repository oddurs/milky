---
import { repo } from '../site';
---

<footer>
  <div class="wrap foot-inner">
    <span>Milky — plain files, on purpose.</span>
    <a href={repo}>Source</a>
    <a class="push" href="#top">Back to top</a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--rule-soft);
    padding: 26px 0 40px;
    color: var(--ink-soft);
    font-size: 13.5px;
  }
  .foot-inner { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; }
  .foot-inner a { color: var(--ink-soft); }
  .foot-inner .push { margin-left: auto; }
</style>
